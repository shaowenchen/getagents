PORT=3000
HOST=0.0.0.0
URI_PREFIX=/getagents
ACCESS_URL=http://localhost:3000/getagents
SESSION_SECRET=getagents-session-secret-change-me
LOG_LEVEL=debug
SQL_DSN=
MAX_UPLOAD_MB=500

# Extra login-only key for the built-in admin account. Normal admin keys are generated randomly.
ADMIN_API_KEY=user-adminAPIKeyChangeMe0000000000000

# File storage driver. Supported values: local, agfs, s3
STORAGE_DRIVER=local

# AGFS storage config. Used only when STORAGE_DRIVER=agfs.
# Point AGFS_ROOT_PATH to any writable AGFS path, for example /s3fs/getagents.
AGFS_API_URL=http://localhost:8080
AGFS_ROOT_PATH=/s3fs/getagents

# Direct S3 storage config. Used only when STORAGE_DRIVER=s3.
AWS_ENDPOINT_URL=
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_URI=s3://getagents/agents