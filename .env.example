PORT=3000
HOST=0.0.0.0
URI_PREFIX=/getagents
ACCESS_URL=http://localhost:3000/getagents
SESSION_SECRET=getagents-session-secret-change-me
LOG_LEVEL=debug
# Database DSN. Leave empty for default SQLite (~/.getagents/getagents.sqlite).
# SQLite:  sqlite:////absolute/path/to/db.sqlite  or  sqlite:relative/path/to/db.sqlite
# MySQL:   mysql://user:password@host:port/database
SQL_DSN=
MAX_UPLOAD_MB=500

# Extra login-only key for the built-in admin account. Normal admin keys are generated randomly.
ADMIN_API_KEY=user-adminAPIKeyChangeMe0000000000000

# File storage driver. Supported values: local, agfs, s3
STORAGE_DRIVER=local

# AGFS storage config. Used only when STORAGE_DRIVER=agfs.
# Point AGFS_ROOT_PATH to any writable AGFS path, for example /s3fs/getagents.
AGFS_API_URL=http://localhost:8080
AGFS_ROOT_PATH=/s3fs/getagents

# Direct S3 storage config. Used only when STORAGE_DRIVER=s3.
# AWS_ENDPOINT_URL may be a full URL or a host; host-only values use https://.
AWS_ENDPOINT_URL=
# Set to false for providers that require bucket.endpoint virtual-host style, such as KS3.
AWS_S3_FORCE_PATH_STYLE=
# Use WHEN_REQUIRED for S3-compatible providers that reject SDK checksum trailers.
AWS_S3_REQUEST_CHECKSUM_CALCULATION=WHEN_REQUIRED
# Presigned URL lifetime for direct CLI uploads, in seconds.
S3_DIRECT_UPLOAD_EXPIRES_SECONDS=900
# Presigned URL lifetime for direct CLI downloads, in seconds. Defaults to S3_DIRECT_UPLOAD_EXPIRES_SECONDS.
S3_DIRECT_DOWNLOAD_EXPIRES_SECONDS=900
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_URI=s3://getagents/agents